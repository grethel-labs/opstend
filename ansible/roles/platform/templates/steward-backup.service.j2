# Generated by steward - do not edit.
[Unit]
Description=steward encrypted backup upload worker
After=network-online.target steward-executor.service
Wants=network-online.target

[Service]
Type=simple
User=steward-backup
Group=steward-backup
SupplementaryGroups=steward-exec steward-obs
ExecStart=/opt/steward/current/venv/bin/steward-backupd --endpoint-file /etc/steward/backup.json --repository-file %d/repository --password-file %d/password{{ ' --username-file %d/username --auth-password-file %d/auth-password' if 'username' in steward_backup.credentials else '' }}{{ ' --ca-file %d/ca' if 'ca' in steward_backup.credentials else '' }}
{% for secret in steward_backup_secrets %}
LoadCredential={{ secret.name }}:/etc/steward/secrets/backup/{{ secret.name }}
{% endfor %}
BindReadOnlyPaths=/etc/steward/backup-hosts:/etc/hosts
ReadOnlyPaths=/var/lib/steward-backup-import
Restart=always
RestartSec=15
TimeoutStopSec=30
StateDirectory=steward-backup
StateDirectoryMode=0700
RuntimeDirectory=steward-backup
RuntimeDirectoryMode=0755
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
{% include 'sandbox.j2' %}{{ '\n' }}
# Ownership changes still obey kernel permissions; no capabilities are granted.
SystemCallFilter=chown fchown fchownat
MemoryMax=512M
CPUQuota=100%
TasksMax=128

[Install]
WantedBy=multi-user.target
