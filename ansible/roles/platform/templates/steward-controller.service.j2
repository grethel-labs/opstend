{% set scan_observations = steward_scanning.enabled and (steward_registry.get('containment', {}).get('enabled') is sameas true) -%}
# Generated by steward - do not edit.
[Unit]
Description=steward self-management controller
After=steward-executor.service

[Service]
Type=simple
User=steward-ctl
Group=steward-ctl
SupplementaryGroups=steward-exec{{ ' steward-obs' if scan_observations or steward_backup.enabled else '' }}
ExecStart=/opt/steward/current/venv/bin/steward-controller{{ ' --backup-socket /run/steward-backup/query.sock' if steward_backup.enabled else '' }}{{ ' --scan-observations' if scan_observations else '' }}
Restart=always
RestartSec=5
ReadWritePaths=/var/lib/steward-controller
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0027
PrivateNetwork=yes
{% include 'sandbox.j2' %}{{ '\n' }}

[Install]
WantedBy=multi-user.target
