# Generated by steward - do not edit.
[Unit]
Description=steward read-only information bot
After=steward-collector.service steward-controller.service

[Service]
Type=simple
User=steward-bot
Group=steward-bot
SupplementaryGroups=steward-obs
ExecStart=/opt/steward/current/venv/bin/steward-bot
{% for secret in steward_bot_secrets %}
LoadCredential={{ secret.name }}:/etc/steward/secrets/bot/{{ secret.name }}
{% endfor %}
Restart=always
RestartSec=5
StateDirectory=steward-bot
StateDirectoryMode=0700
Environment=PYTHONDONTWRITEBYTECODE=1
{% if steward_inference_candidate is defined and site_inference_run is defined
      and (steward_inference_candidate.advice | default(false)) is sameas true and not ansible_check_mode %}
Environment=STEWARD_BOT_ADVICE_BACKEND=managed-local
{% endif %}
UMask=0077
{% include 'sandbox.j2' %}{{ '\n' }}

[Install]
WantedBy=multi-user.target
