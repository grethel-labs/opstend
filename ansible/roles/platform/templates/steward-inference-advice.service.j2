[Service]
Type=exec
Sockets=steward-inference-advice-bot.socket steward-inference-advice-api.socket
ExecStartPre=/usr/bin/python3 -I -c "import os; raise SystemExit(set(os.listdir('/sys/class/net')) != {'lo'})"
