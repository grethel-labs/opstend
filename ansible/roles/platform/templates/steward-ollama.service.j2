# Generated by steward - do not edit.
[Unit]
Description=Steward isolated Ollama inference

[Service]
Type=exec
User=steward-ai
Group=steward-ai
StateDirectory=steward-ai
StateDirectoryMode=0700
WorkingDirectory=/var/lib/steward-ai
UMask=0077
# Refuse startup if the kernel could not provide the loopback-only namespace.
ExecStartPre=/usr/bin/python3 -I -c "import os; raise SystemExit(set(os.listdir('/sys/class/net')) != {'lo'})"
ExecStart={{ platform_ollama_artifacts.binary }} serve
Environment=HOME=/var/lib/steward-ai
Environment=OLLAMA_MODELS={{ platform_ollama_artifacts.models }}
Environment=OLLAMA_NO_CLOUD=1
Environment=OLLAMA_NOPRUNE=1
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1

PrivateNetwork=yes
RestrictAddressFamilies=AF_INET
RestrictNamespaces=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths={{ platform_ollama_artifacts.models }}
InaccessiblePaths=/run -/etc/steward -/srv/steward -/var/cache/steward-tools -/var/lib/steward-controller
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes

CPUQuota=100%
MemoryMax={{ steward_ollama_local.ai.local.ram_mb }}M
TasksMax=128
Restart=on-failure

[Install]
WantedBy=multi-user.target
