User=steward-inference
Group=steward-inference
StateDirectory=steward-inference
StateDirectoryMode=0700
WorkingDirectory=/var/lib/steward-inference
UMask=0077

PrivateNetwork=yes
InaccessiblePaths=-/etc/steward/config -/etc/steward/executor.json -/etc/steward/secrets -/etc/steward/pki -/srv/steward
InaccessiblePaths=-/var/lib/steward-api -/var/lib/steward-ai -/var/lib/steward-controller -/var/lib/steward-col -/var/lib/steward-executor -/var/cache/steward-tools
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=256M
TasksMax=64
