# Generated by steward - do not edit.
[Unit]
Description=steward event collector
After=steward-executor.service steward-controller.service

[Service]
Type=simple
User=steward-col
Group=steward-col
SupplementaryGroups=steward-exec steward-obs
ExecStart=/opt/steward/current/venv/bin/steward-collector --retention-days {{ steward_events.retention_days }} --max-events {{ steward_events.max_events }}{{ ' --scanner-socket=' if not steward_scanning.enabled else '' }}{{ ' --backup-socket /run/steward-backup/query.sock' if steward_backup.enabled else '' }}
Restart=always
RestartSec=5
StateDirectory=steward-collector
StateDirectoryMode=0700
RuntimeDirectory=steward-collector
RuntimeDirectoryMode=0755
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
PrivateNetwork=yes
{% include 'sandbox.j2' %}{{ '\n' }}
# The owner may assign its query socket to supplementary steward-obs; capability
# and kernel UID/group checks still apply. @privileged otherwise denies this.
SystemCallFilter=chown fchownat

[Install]
WantedBy=multi-user.target
