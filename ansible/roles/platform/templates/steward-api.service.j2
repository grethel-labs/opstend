# Generated by steward - do not edit.
[Unit]
Description=steward administration API
After=network.target steward-executor.service

[Service]
Type=simple
User=steward-api
Group=steward-api
SupplementaryGroups=steward-exec
ExecStart=/opt/steward/current/venv/bin/steward-api --port {{ steward_admin.backend_port }}
Restart=on-failure
RestartSec=3
LoadCredential=admin_token:/etc/steward/secrets/admin_token
Environment=STEWARD_ADMIN_TOKEN_FILE=%d/admin_token
{% if steward_admin.allowed_origins is defined or (steward_admin.access | default('private')) == 'private-lan' %}
Environment=STEWARD_ALLOWED_ORIGINS={{ steward_admin.allowed_origins | join(',') }}
{% else %}
{% set port_suffix = ':' ~ steward_admin.port %}
{% set hosts = ['localhost', '127.0.0.1', steward_admin.hostname] | unique | list %}
Environment=STEWARD_ALLOWED_ORIGINS=https://{{ hosts | join(port_suffix ~ ',https://') }}{{ port_suffix }}
{% endif %}
Environment=STEWARD_SESSION_TTL_MINUTES={{ steward_admin.session_ttl_minutes }}
{% if steward_inference_candidate is defined and site_inference_run is defined %}
Environment=STEWARD_AI_ADMIN_BACKEND=managed-local
{% if (steward_inference_candidate.advice | default(false)) is sameas true and not ansible_check_mode %}
Environment=STEWARD_API_ADVICE_BACKEND=managed-local
{% endif %}
{% endif %}
{% if not steward_scanning.enabled %}
Environment=STEWARD_SCANNER_SOCKET=
{% endif %}
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=steward-api
StateDirectoryMode=0700
UMask=0077
{% include 'sandbox.j2' %}{{ '\n' }}

[Install]
WantedBy=multi-user.target
