# Generated by steward - do not edit.
[Unit]
Description=steward notification worker
After=steward-collector.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=steward-notify
Group=steward-notify
SupplementaryGroups=steward-obs
ExecStart=/opt/steward/current/venv/bin/steward-notifier --config /etc/steward/notifications.json
{% for secret in steward_channel_secrets %}
LoadCredential={{ secret.name }}:/etc/steward/secrets/notifications/{{ secret.name }}
{% endfor %}
Restart=always
RestartSec=5
StateDirectory=steward-notifier
StateDirectoryMode=0700
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
{% include 'sandbox.j2' %}{{ '\n' }}

[Install]
WantedBy=multi-user.target
