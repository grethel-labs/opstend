# Generated by steward - do not edit.
[Unit]
Description=Steward local model scan
{% if platform_inference_private | default(false) %}
Requisite=steward-inference-egress.socket
After=steward-inference-egress.socket
{% else %}
Requisite=steward-ollama.service
After=steward-ollama.service
JoinsNamespaceOf=steward-ollama.service
{% endif %}

[Service]
Type=oneshot
TimeoutStartSec=45s
ExecStartPre=/usr/bin/python3 -I -c "import os; raise SystemExit(set(os.listdir('/sys/class/net')) != {'lo'})"
{% if platform_inference_private | default(false) %}
ExecStart=/opt/steward/current/venv/bin/python -I -m steward.inference_worker _private-candidate-tick
RestrictAddressFamilies=AF_UNIX
TemporaryFileSystem=/run:ro
BindReadOnlyPaths=/run/steward-inference-egress/provider.sock
{% else %}
ExecStart=/opt/steward/current/venv/bin/python -I -m steward.inference_worker _local-candidate-tick
RestrictAddressFamilies=AF_INET
InaccessiblePaths=/run
{% endif %}
{% include 'inference-sandbox.j2' %}{{ '\n' }}
{% if platform_inference_private | default(false) %}
SystemCallFilter=~bind listen
SystemCallErrorNumber=EPERM
{% endif %}
PrivateTmp=false
TemporaryFileSystem=/tmp:mode=1777,size=16M,nosuid,nodev,noexec /var/tmp:mode=1777,size=16M,nosuid,nodev,noexec
