# Generated by steward - do not edit.
[Unit]
Description=steward application workloads
After=steward-firewall.service
After=steward-executor.service
Wants=steward-executor.service
{% for uid in workloads_application_boot_uids %}
After=user@{{ uid }}.service
{% endfor %}
{% if steward_proxy is defined and steward_proxy.application_runtime is defined %}
After=user@{{ steward_uids['steward-proxy'] }}.service
{% endif %}
BindsTo=steward-firewall.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/steward/current/venv/bin/python -m steward.application_boot start
ExecStop=/opt/steward/current/venv/bin/python -m steward.application_boot stop
ExecStopPost=/opt/steward/current/venv/bin/python -m steward.application_boot recover-start
TimeoutStartSec=15min
TimeoutStopSec=5min

[Install]
WantedBy=multi-user.target
