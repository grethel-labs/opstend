[Unit]
Description=OpsTend (web app, API, automation)
Documentation=https://github.com/grethel-labs/opstend
After=network-online.target opstend-agent.service
Wants=network-online.target opstend-agent.service

[Service]
Type=exec
User=opstend
Group=opstend
ExecStart=/opt/opstend/current/bin/opstend serve --config /etc/opstend/opstend.yaml --tls-cert /etc/opstend/tls.crt --tls-key /etc/opstend/tls.key
Restart=on-failure
RestartSec=5
# Port 443/8443 without root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/opstend
ReadOnlyPaths=/etc/opstend
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
