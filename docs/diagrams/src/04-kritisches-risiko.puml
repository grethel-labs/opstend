@startuml
title Kritisches Risiko – Exposition, Sicherung und Wiederfreigabe (Kandidat)
skinparam shadowing false
|Scanner und Controller|
start
:Frische runtime- und revisionsgebundene Befunde bewerten;
if (Kritisch und exponiert?) then (nein)
  :Befund oder Evidenzlücke melden;
  stop
endif
|Executor|
:Root-Registry, Exposition und Richtlinie prüfen;
:Frist beachten, bei zugelassener KEV-Ausnahme sofort trennen;
:Proxy-Zugriff zu Backends per nftables sperren;
if (Explizit stateless?) then (nein)
  :Gruppen-Capture erstellen und zurücklesen;
  if (Capture verifiziert?) then (nein)
    #MistyRose:Eskalieren, Stack bleibt getrennt in Betrieb;
    stop
  endif
endif
:Stopp ankündigen und in umgekehrter Abhängigkeitsfolge stoppen;
:Korrigierten Stack getrennt starten;
if (Frischer Befund für laufendes Image = not_affected?) then (ja)
  #PaleGreen:Proxy-Zugriff wieder freigeben;
else (nein)
  #MistyRose:Sperre beibehalten;
endif
stop
@enduml
