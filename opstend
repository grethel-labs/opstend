#!/usr/bin/env bash
# OpsTend entry point.
# Creates a pinned, hash-verified controller environment on first use, then
# runs the OpsTend CLI. Nothing is downloaded from unpinned sources.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORK="$ROOT/.steward"
VENV="$WORK/venv"
LOCK="$ROOT/requirements/controller.txt"
GALAXY="$ROOT/ansible/requirements.yml"
STAMP="$WORK/bootstrap.stamp"

want="$(cat "$LOCK" "$GALAXY" | sha256sum | cut -d' ' -f1)"
if [ ! -x "$VENV/bin/python" ] || [ "$(cat "$STAMP" 2>/dev/null || true)" != "$want" ]; then
    echo "opstend: preparing pinned controller environment in $WORK" >&2
    PY="${OPSTEND_PYTHON:-${STEWARD_PYTHON:-python3}}"
    "$PY" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)' || {
        echo "opstend: Python 3.12 or newer is required on the controller" >&2
        exit 1
    }
    mkdir -p "$WORK"
    chmod 700 "$WORK"
    rm -rf "$VENV"
    "$PY" -m venv "$VENV"
    "$VENV/bin/python" -m pip install --quiet --disable-pip-version-check \
        --require-hashes --only-binary=:all: -r "$LOCK"
    ANSIBLE_NOCOWS=1 "$VENV/bin/ansible-galaxy" collection install --force \
        -r "$GALAXY" -p "$WORK/collections" >&2
    echo "$want" >"$STAMP"
fi

export OPSTEND_ROOT="$ROOT"
export STEWARD_ROOT="$ROOT"
export PYTHONPATH="$ROOT/src"
export PYTHONDONTWRITEBYTECODE=1
exec "$VENV/bin/python" -m steward.cli.main "$@"
