diff --git a/libpod/steward_custody.go b/libpod/steward_custody.go
new file mode 100644
index 0000000..4f8f500
--- /dev/null
+++ b/libpod/steward_custody.go
@@ -0,0 +1,120 @@
+//go:build !remote && (linux || freebsd)
+
+package libpod
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"regexp"
+	"runtime"
+
+	"github.com/containers/podman/v5/libpod/define"
+	"github.com/containers/podman/v5/pkg/rootless"
+)
+
+var (
+	custodyID          = regexp.MustCompile(`^[0-9a-f]{64}$`)
+	errCustodyConflict = errors.New("pod custody conflict")
+	errCustodyNotFound = errors.New("pod custody target absent")
+	errCustodyNotEmpty = errors.New("pod custody target has another container")
+)
+
+// StewardRemoveEmptyPod removes a pod and its verified, inactive infra
+// container. This experimental operation requires a local rootless file-lock
+// runtime on linux/amd64 using SQLite and vfs.
+func (r *Runtime) StewardRemoveEmptyPod(ctx context.Context, podID, infraID string) (string, error) {
+	if !custodyID.MatchString(podID) || !custodyID.MatchString(infraID) {
+		return "conflict", fmt.Errorf("%w: expected full lowercase pod and infra IDs", errCustodyConflict)
+	}
+	if !r.valid {
+		return "", define.ErrRuntimeStopped
+	}
+	_, sqlite := r.state.(*SQLiteState)
+	if runtime.GOOS != "linux" || runtime.GOARCH != "amd64" || !rootless.IsRootless() ||
+		!sqlite || r.config.Engine.LockType != "file" || r.store.GraphDriverName() != "vfs" {
+		return "conflict", fmt.Errorf("%w: expected rootless linux/amd64 with SQLite, vfs and file locks", errCustodyConflict)
+	}
+
+	pod, err := r.GetPod(podID)
+	if errors.Is(err, define.ErrNoSuchPod) {
+		return "not_found", err
+	}
+	if err != nil {
+		return "", err
+	}
+	if pod.ID() != podID {
+		return "conflict", fmt.Errorf("%w: pod ID does not match its database entry", errCustodyConflict)
+	}
+
+	// Container admission takes this same lock around AddContainerToPod.
+	pod.lock.Lock()
+	defer pod.lock.Unlock()
+
+	removed, err := r.removePodWithExpectedInfra(ctx, pod, true, false, nil, infraID)
+	if err != nil {
+		// Retain the specific error reported by the graph worker.
+		if containerErr := removed[infraID]; containerErr != nil {
+			if errors.Is(containerErr, errCustodyConflict) {
+				return "conflict", containerErr
+			}
+			return "", errors.Join(err, containerErr)
+		}
+		switch {
+		case errors.Is(err, errCustodyNotFound):
+			return "not_found", err
+		case errors.Is(err, errCustodyNotEmpty):
+			return "not_empty", err
+		case errors.Is(err, errCustodyConflict):
+			return "conflict", err
+		default:
+			return "", err
+		}
+	}
+	if removeErr, ok := removed[infraID]; !ok || removeErr != nil {
+		return "", fmt.Errorf("removal did not report success for infra container %s", infraID)
+	}
+	return "removed", nil
+}
+
+func (r *Runtime) checkCustodyInfra(pod *Pod, containers []*Container, expectedInfra string) error {
+	if pod.state.InfraContainerID != expectedInfra {
+		return fmt.Errorf("%w: the pod records a different infra container", errCustodyConflict)
+	}
+	for _, ctr := range containers {
+		if ctr.ID() != expectedInfra {
+			return fmt.Errorf("%w: %s", errCustodyNotEmpty, ctr.ID())
+		}
+	}
+	if len(containers) != 1 {
+		return fmt.Errorf("%w: expected exactly one infra container", errCustodyConflict)
+	}
+	infra := containers[0]
+	member, err := r.state.PodHasContainer(pod, expectedInfra)
+	if err != nil {
+		return err
+	}
+	if !member || !infra.IsInfra() || infra.PodID() != pod.ID() || infra.config.LockID == pod.config.LockID {
+		return fmt.Errorf("%w: infra identity or membership could not be verified", errCustodyConflict)
+	}
+	if infra.config.Spec == nil {
+		return fmt.Errorf("%w: infra has no OCI specification", errCustodyConflict)
+	}
+	// Container removal can unlink an arbitrary CID-file path stored in the
+	// spec. This protocol does not authorize that ancillary removal.
+	_, hasCIDFile := infra.config.Spec.Annotations[define.InspectAnnotationCIDFile]
+	if pod.hasServiceContainer() || infra.IsService() || hasCIDFile || len(infra.config.UserVolumes) != 0 ||
+		len(infra.config.NamedVolumes) != 0 || len(infra.config.OverlayVolumes) != 0 ||
+		len(infra.config.ImageVolumes) != 0 || len(infra.config.ArtifactVolumes) != 0 ||
+		len(infra.Dependencies()) != 0 {
+		return fmt.Errorf("%w: pod or infra has ancillary resources or dependencies", errCustodyConflict)
+	}
+	dependents, err := r.state.ContainerInUse(infra)
+	if err != nil {
+		return err
+	}
+	if len(dependents) != 0 {
+		return fmt.Errorf("%w: infra has dependent containers", errCustodyConflict)
+	}
+	return nil
+}
