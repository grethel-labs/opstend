+//go:build linux && !remote
+
+package pods
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/containers/podman/v5/cmd/podman/registry"
+	"github.com/containers/podman/v5/cmd/podman/validate"
+	"github.com/containers/podman/v5/pkg/domain/infra/abi"
+	"github.com/containers/podman/v5/pkg/rootless"
+	"github.com/spf13/cobra"
+)
+
+func init() {
+	if registry.IsRemote() {
+		return
+	}
+
+	custody := &cobra.Command{
+		Use:    "steward-custody-v1",
+		Short:  "Experimental Steward pod custody protocol",
+		Hidden: true,
+		RunE:   validate.SubCommandExists,
+	}
+	custody.AddCommand(&cobra.Command{
+		Use:   "protocol",
+		Short: "Print the local protocol version",
+		Args:  cobra.NoArgs,
+		// Capability discovery does not initialize Podman's runtime or enter a namespace.
+		PersistentPreRunE: func(_ *cobra.Command, _ []string) error {
+			if registry.IsRemote() {
+				return errors.New("Steward pod custody requires local Podman")
+			}
+			return nil
+		},
+		RunE: func(cmd *cobra.Command, _ []string) error {
+			_, err := fmt.Fprintln(cmd.OutOrStdout(), "steward-pod-custody-v1")
+			return err
+		},
+	}, &cobra.Command{
+		Use:   "remove-empty POD_ID INFRA_ID",
+		Short: "Remove a pod containing only its verified inactive infra container",
+		Args:  cobra.ExactArgs(2),
+		RunE:  stewardRemoveEmpty,
+	})
+	registry.Commands = append(registry.Commands, registry.CliCommand{Command: custody, Parent: podCmd})
+}
+
+func stewardRemoveEmpty(cmd *cobra.Command, args []string) error {
+	engine, local := registry.ContainerEngine().(*abi.ContainerEngine)
+	if !local || registry.IsRemote() || !rootless.IsRootless() {
+		_, err := fmt.Fprintln(cmd.OutOrStdout(), "conflict")
+		return errors.Join(errors.New("Steward pod custody requires local rootless Podman"), err)
+	}
+	result, removeErr := engine.Libpod.StewardRemoveEmptyPod(registry.Context(), args[0], args[1])
+	if result == "" {
+		return removeErr
+	}
+	_, writeErr := fmt.Fprintln(cmd.OutOrStdout(), result)
+	return errors.Join(removeErr, writeErr)
+}
